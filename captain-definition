{
  "schemaVersion": 2,
   "dockerfileLines": [
                        "FROM node:18.11.0-alpine",
                        "RUN mkdir -p /usr/src/app",
                        "WORKDIR /usr/src/app",
                        "COPY ./package.json /usr/src/app/",
                        "RUN npm install --force",
                        "COPY ./ /usr/src/app",
                        "ENV NODE_ENV production",
                        "ENV PORT 3101",
                        "EXPOSE 3101",
                        "RUN npm run build",
                        "CMD [ \"npm\", \"start\" ]"
                    ]
 }
